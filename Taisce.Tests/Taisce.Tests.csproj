<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Taisce.Tests</RootNamespace>
    <!-- MAAI001: the framework's InvokingContext and InvokedContext constructors are marked
         experimental. Only a test constructs them; the library overrides methods that receive them.
         The suppression is scoped here so a change to those constructors breaks the tests and not
         the library, which is the right blast radius. -->
    <NoWarn>$(NoWarn);MAAI001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Taisce.AgentFramework/Taisce.AgentFramework.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.3" />
  </ItemGroup>
</Project>
